# Copy to .env. Never commit real credentials.
OPENAI_API_KEY=
# Local demo only: X-User-Id selects a seeded business user.
DEMO_AUTH_ENABLED=true
POSTGRES_DB=kazast_ai
POSTGRES_USER=kazast
POSTGRES_PASSWORD=kazast_local
# For backend commands run on the host (Docker uses its internal hostname).
DATABASE_URL=

# AI_MODE: openai, local, or empty (auto by key presence)
AI_MODE=
OPENAI_MODEL=gpt-4o-mini
